# Recommended for local `npm run dev`: same-origin + Vite proxy (see vite.config.ts).
VITE_API_BASE_URL=/api/v1
# Optional: explicit backend URL (cross-origin; requires CORS to allow this dev origin, e.g. http://localhost:5173).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# Docker Compose `web` service sets DEV_API_PROXY_TARGET=http://api:8000
