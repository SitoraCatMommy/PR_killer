# Application
APP_NAME=research-intelligence-agent
APP_ENV=local
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# Server (uvicorn)
HOST=0.0.0.0
PORT=8000

# PostgreSQL (async URL for app; sync URL for Alembic / Alembic CLI)
# Local: localhost. Docker Compose overrides DATABASE_* for api/worker to @postgres.
DATABASE_URL=postgresql+asyncpg://ria:ria@localhost:5432/research_intel
DATABASE_URL_SYNC=postgresql+psycopg://ria:ria@localhost:5432/research_intel

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Embeddings / dedup (must match vector column dimension in migrations)
EMBEDDING_DIMENSION=1536

# Project processing queue (one unified stream per project; batch groups deprecated in UI)
PROJECT_QUEUE_ENABLED=true
PROJECT_QUEUE_CONCURRENCY=1

# Writable directory for uploads (create it or let the app mkdir on first save)
# Docker: compose sets UPLOAD_STORAGE_PATH=/data/uploads and mounts volume.
UPLOAD_STORAGE_PATH=./data/uploads

# Research entity extraction: mock | gpt
RESEARCH_EXTRACTION_PROVIDER=gpt
# Summary: deterministic | gpt
RESEARCH_SUMMARY_PROVIDER=gpt
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# PR report flow safeguards. Report generation will not spend final-report tokens
# until enough PR-synthesis signals exist, and auto-extraction from the report
# button is capped to avoid unexpectedly large GPT extraction runs.
PR_REPORT_MIN_SYNTHESIS_ENTITIES=3
PR_REPORT_MAX_AUTO_EXTRACT_CHUNKS=40
PR_REPORT_AUTO_PREPARE=true
PR_REPORT_MAX_PROMPT_CHARS=45000
PR_REPORT_MAX_REPAIR_ATTEMPTS=1

# Text chunking (Celery)
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=80
DOCUMENT_PIPELINE_ACTIVE_TTL_SECONDS=900
# When chunking strategy is `auto`, use semantic (OpenAI) splitting per interview unit if unit text length >= this.
CHUNK_SEMANTIC_MIN_CHARS=200000

# OpenAI (paste your key; leave empty only if you rely on mock fallbacks where supported)
OPENAI_API_KEY=
OPENAI_SEMANTIC_CHUNK_MODEL=gpt-4o-mini
OPENAI_SEMANTIC_CHUNK_WINDOW_CHARS=24000
# Chat/completions HTTP read budget (seconds). Increase if Celery workers hit httpx.ReadTimeout under parallel batches.
OPENAI_HTTP_TIMEOUT_SECONDS=900

# Max size (bytes) of each opus slice sent to ASR (OpenAI file limit 25 MB; default 20 MiB).
TRANSCRIPTION_MAX_SEGMENT_BYTES=20971520

# Research audio transcription: openai | mock | whisper_local | http | gemini
RESEARCH_TRANSCRIPTION_PROVIDER=openai
RESEARCH_TRANSCRIPTION_FALLBACK_TO_MOCK=false
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=300

# Gemini (required when RESEARCH_TRANSCRIPTION_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_TIMEOUT_SECONDS=900
# One-shot Gemini on the original file when duration ≤ this (seconds) and size ≤ inline cap; otherwise ffmpeg chunks.
GEMINI_TRANSCRIPTION_FAST_PATH_MAX_DURATION_SECONDS=3600

AUDIO_TRANSCRIPTION_CHUNK_SECONDS=480
AUDIO_TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=5

# Local Whisper CLI (RESEARCH_TRANSCRIPTION_PROVIDER=whisper_local)
# WHISPER_LOCAL_COMMAND=whisper
# WHISPER_LOCAL_MODEL=base
# WHISPER_LOCAL_TIMEOUT_SECONDS=3600

# Custom HTTP ASR (RESEARCH_TRANSCRIPTION_PROVIDER=http)
# TRANSCRIPTION_API_URL=
# TRANSCRIPTION_API_KEY=
